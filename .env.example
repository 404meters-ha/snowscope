# ========== GitHub ==========
# 个人访问令牌（必须）：https://github.com/settings/tokens 勾选 repo / read:user 即可
# 没有 token 时 GitHub API 限流 60 次/小时，基本不可用
GITHUB_TOKEN=

# 可选：本机代理（仅访问 github.com 网页端爬 trending 用，如 http://127.0.0.1:7890）
# 配置后自动启用"真实 trending 页面"抓取通道
GITHUB_PROXY=

# ========== LLM（GLM Coding Plan）==========
# OpenAI 兼容端点。实现接入时由使用者提供 base_url / api_key / model
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-4.7

# ========== 搜索（企业落地场景验证）==========
# 可选 provider: bocha | tavily | zai | 留空则只用 README 中明确声明案例（保守模式）
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ========== 采集与分析规模 ==========
CANDIDATE_POOL=100      # Search API 候选池大小
TOP_N_LLM=30            # 规则粗筛后进入 LLM 精析的数量
SCHED_HOUR=8            # 每日抓取分析时间（小时）

# ========== 内置 Agent SDK（技能 / AI 命令无头执行）==========
SKILL_RUN_TIMEOUT=3600          # 单次技能/agent 执行超时（秒）
PLATFORM_API_BASE=http://127.0.0.1:8100  # PlatformAPI 工具回访本服务的地址（云端部署改对外域名）

# ========== 课程发布目录（/tech 课程 HTML 落盘用）==========
# 发布文件写到这个目录；平台自动把它静态托管在 /published（无需 nginx 即可访问）。
# 服务器上 nginx 托管同一目录时，把 LOCAL_PUBLISH_BASE_URL 设成 nginx 的对外地址。
LOCAL_PUBLISH_DIR=./published   # 相对项目根或绝对路径（Linux 建议 /var/www/... 等 nginx 目录）
LOCAL_PUBLISH_BASE_URL=         # 留空 = {PLATFORM_API_BASE}/published

# ========== 子路径部署（如 https://域名/celestial-snow/）==========
# 后端中间件剥掉请求路径里的该前缀（nginx 透传或剥前缀都兼容），
# 前端构建 base 也读它（frontend/vite.config.js）。改动后需重新构建前端。
BASE_PATH=                      # 留空 = 根路径部署（本地默认）
